{
  "name": "@l92-labs/gmail-mcp",
  "version": "0.3.0-l92.0",
  "description": "Streamable HTTP MCP server for Gmail \u2014 L92-Labs fork: portal-friendly bearer, mode-gated tools, enforced send allowlist",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/__tests__/**",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L92-Labs/gmail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/L92-Labs/gmail-mcp/issues"
  },
  "homepage": "https://github.com/L92-Labs/gmail-mcp#readme",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "auth": "tsx src/index.ts auth",
    "test": "vitest run",
    "e2e": "tsc -p tsconfig.build.json && tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "author": "Joseph R. Quinn",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^2.1.0",
    "googleapis": "^176.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
